#!/bin/sh
# Take pictures and videos with the Pixel 2 cameras (P8.5, mainline kernel).
#   pixel2-camera photo [rear|front] [file.jpg]        (default rear, ./photo-<time>.jpg)
#   pixel2-camera video [rear|front] [seconds] [file.mp4]  (default rear, 10 s)
#   pixel2-camera list
# libcamera (built by scripts/build-libcamera.sh, under /usr/local) + GStreamer.
# Photos: frames stream until the picture has settled, and only the last one
# is kept. The rear waits for the soft-ISP contrast autofocus to log "Scan
# done" (~9 s: the CPU ISP runs ~5 fps at 3840x2400 and the scan takes ~45
# frames); the front is fixed-focus and keeps frame 30 (auto-exposure).
# Video: 1280x720 H.264 (x264, CPU) in MP4, 4:2:0 so any player decodes it.
# Output is turned upright for the phone held in portrait: both sensors are
# mounted at 270 degrees (libcamera "Rotation", from the DT), so frames are
# rotated 90 degrees counter-clockwise. PIXEL2_CAMERA_ROTATE=0 keeps the
# sensor's landscape frames (phone standing on its side).
set -eu
export GST_PLUGIN_PATH=/usr/local/lib/aarch64-linux-gnu/gstreamer-1.0
REAR=/base/soc@0/cci@ca0c000/i2c-bus@0/camera@1a
FRONT=/base/soc@0/cci@ca0c000/i2c-bus@1/camera@10
ts=$(date +%Y%m%d-%H%M%S)
# Neither photos nor videos have their pixels turned: rotating on the CPU is
# too slow next to the soft-ISP (a 9 MP videoflip took >10 s per frame, so
# only the first, still-black frame was ever encoded; 720p video lost a
# quarter of its frame rate). Like phone cameras, the files carry the turn
# instead: EXIF Orientation 8 in the JPEG, the track matrix in the MP4 (mp4mux
# 1.24 ignores the image-orientation tag, so both are written afterwards).
if [ "${PIXEL2_CAMERA_ROTATE:-1}" = 0 ]; then rot=0; else rot=1; fi

# Put an EXIF APP1 with Orientation = 8 ("turn 90 degrees counter-clockwise
# to view") straight after the JPEG's SOI. 34-byte segment: "Exif\0\0", a
# big-endian TIFF header, IFD0 with the one entry 0x0112 SHORT 1 = 8.
jpeg_rotate_ccw() {
    { head -c 2 "$1"
      printf '\377\341\000\042Exif\000\000MM\000\052\000\000\000\010\000\001\001\022\000\003\000\000\000\001\000\010\000\000\000\000\000\000'
      tail -c +3 "$1"; } > "$1.tmp" && mv "$1.tmp" "$1"
}

# Set the tkhd matrix of a 1280-wide single-track MP4 to "rotate 90 degrees
# counter-clockwise": (x,y) -> (y, 1280-x), i.e. a=0 b=-1 c=1 d=0 ty=1280.
# mp4mux writes moov after mdat, so the last "tkhd" is the real one; the
# matrix sits 44 bytes after the name in a version-0 tkhd.
mp4_rotate_ccw() {
    off=$(grep -obUa tkhd "$1" | tail -1 | cut -d: -f1)
    [ -n "$off" ] || { echo "no tkhd in $1, left unrotated" >&2; return 0; }
    ver=$(dd if="$1" bs=1 skip=$((off + 4)) count=1 2>/dev/null | od -An -tu1 | tr -d ' ')
    [ "$ver" = 0 ] || { echo "tkhd v$ver in $1, left unrotated" >&2; return 0; }
    printf '\000\000\000\000\377\377\000\000\000\000\000\000\000\001\000\000\000\000\000\000\000\000\000\000\000\000\000\000\005\000\000\000\100\000\000\000' \
        | dd of="$1" bs=1 seek=$((off + 44)) conv=notrunc 2>/dev/null
}
cam_of() { case "${1:-rear}" in rear) echo $REAR ;; front) echo $FRONT ;; *) echo "rear or front, not '$1'" >&2; exit 2 ;; esac; }

case "${1:-}" in
list)
    cam -l 2>/dev/null ;;
photo)
    c=$(cam_of "${2:-rear}"); out=${3:-photo-$ts.jpg}
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    # the leaky queue drops frames while jpegenc is busy, so encoding does
    # not slow the stream the autofocus is measuring
    [ "$c" = "$REAR" ] && frames=150 || frames=30
    LIBCAMERA_LOG_LEVELS=IPASoftAf:0 gst-launch-1.0 -q libcamerasrc camera-name="$c" \
        ! identity eos-after=$frames ! queue leaky=downstream max-size-buffers=1 \
        ! videoconvert ! jpegenc quality=92 \
        ! multifilesink location="$tmp/f%05d.jpg" max-files=1 >/dev/null 2>"$tmp/log" &
    pid=$!
    if [ "$c" = "$REAR" ]; then
        until grep -q "Scan done" "$tmp/log" || ! kill -0 $pid 2>/dev/null; do sleep 0.2; done
        sleep 1.5   # frames already in flight were taken while the lens moved
        kill -INT $pid 2>/dev/null || true
    fi
    wait $pid || true
    mv "$(ls "$tmp"/f*.jpg | tail -1)" "$out"
    [ "$rot" = 1 ] && jpeg_rotate_ccw "$out"
    echo "$out" ;;
video)
    c=$(cam_of "${2:-rear}"); secs=${3:-10}; out=${4:-video-$ts.mp4}
    gst-launch-1.0 -q -e libcamerasrc camera-name="$c" \
        ! video/x-raw,width=1280,height=720 ! videoconvert ! video/x-raw,format=I420 ! queue \
        ! x264enc speed-preset=ultrafast tune=zerolatency bitrate=6000 \
        ! mp4mux ! filesink location="$out" >/dev/null 2>&1 &
    pid=$!
    sleep "$secs"; kill -INT $pid; wait $pid || true
    [ "$rot" = 1 ] && mp4_rotate_ccw "$out"
    echo "$out" ;;
*)
    sed -n 2,8p "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
