#!/bin/sh
# "Phone is on" indicator: the RGB notification LED pulses dim green (never
# fully dark) once Ubuntu is up, and goes dark at shutdown.
#
#   pixel2-status-led [start]   pulse green between MIN and MAX percent
#   pixel2-status-led stop      LED off
#
# How this kernel's LED driver (leds-qpnp.c) works, and why it's done this way:
# - Plain `brightness` writes do nothing for the RGB LED (the RGB case in
#   __qpnp_led_work is empty), so LED triggers (heartbeat...) can't drive it.
# - `rgb_start` is what lights it (Android's lights-HAL path). The PMIC then
#   runs a lookup-table (LUT) pattern by itself, with no CPU wakeups.
# - If `on_off_ms` was ever written, rgb_start rebuilds the LUT from it, and
#   that table always ramps down to 0 (dark). With on_ms still 0 (never
#   written since boot) rgb_start keeps the LUT we load via duty_pcts, so the
#   pulse can have a floor. So: never write on_off_ms.
# Check: PMI8998 register 0xd046 (RGB enable) = 40 for green only:
#   sudo grep ^d046 /sys/kernel/debug/regmap/spmi0-03/registers
L=/sys/class/leds
LED=${LED:-green}
MIN=${MIN:-3} MAX=${MAX:-20} STEPS=${STEPS:-12}   # duty percent, table length
STEP_MS=${STEP_MS:-80}                            # per table entry
PAUSE_HI_MS=${PAUSE_HI_MS:-200} PAUSE_LO_MS=${PAUSE_LO_MS:-500}

# Mainline kernel (leds-qcom-lpg): one multicolor LED "rgb:status"
# (multi_index blue green red). The pattern trigger's hw_pattern runs the
# same kind of PMIC LUT pulse; entries are "level ms level 0" pairs, the
# palindrome makes the LPG play it ping-pong, the first entry's time is the
# low pause and the middle one's the high pause.
MC=$L/rgb:status
if [ -d $MC ]; then
    case "${1:-start}" in
    start)
        max=$(cat $MC/max_brightness)
        pat=$(awk -v a="$MIN" -v b="$MAX" -v n="$STEPS" -v m="$max" -v s="$STEP_MS" \
                  -v lo="$PAUSE_LO_MS" -v hi="$PAUSE_HI_MS" 'BEGIN {
            for (i = 0; i < 2 * n - 1; i++) {
                k = (i < n) ? i : 2 * n - 2 - i
                v = int(m * (a + (b - a) * k / (n - 1)) / 100 + 0.5)
                t = (i == 0) ? lo : ((i == n - 1) ? hi : s)
                printf "%s%d %d %d 0", (i ? " " : ""), v, t, v }
        }')
        echo none > $MC/trigger
        case $LED in red) i="0 0 $max";; blue) i="$max 0 0";; *) i="0 $max 0";; esac
        echo "$i" > $MC/multi_intensity
        echo pattern > $MC/trigger
        echo -1 > $MC/repeat
        if echo "$pat" > $MC/hw_pattern 2>/dev/null; then
            echo "pixel2-status-led: $LED pulsing (hw), $MIN-$MAX %"
        else
            echo none > $MC/trigger
            echo $((max * MAX / 100)) > $MC/brightness
            echo "pixel2-status-led: hw_pattern refused, $LED steady at $MAX %"
        fi
        ;;
    stop) echo none > $MC/trigger; echo 0 > $MC/brightness ;;
    *)  echo "usage: $0 [start|stop]" >&2; exit 2 ;;
    esac
    exit 0
fi

case "${1:-start}" in
start)
    if [ "$(cat $L/$LED/on_off_ms)" != "0 0" ] 2>/dev/null; then
        echo "pixel2-status-led: on_off_ms was set this boot; the floor needs a reboot" >&2
    fi
    for c in red green blue; do echo 0 > $L/$c/brightness; done
    duty=$(awk -v a="$MIN" -v b="$MAX" -v n="$STEPS" 'BEGIN {
        for (i = 0; i < n; i++) printf "%s%d", (i ? "," : ""), a + (b - a) * i / (n - 1) + 0.5 }')
    d=$L/$LED
    echo "$STEP_MS"     > $d/ramp_step_ms
    echo "$PAUSE_HI_MS" > $d/pause_hi
    echo "$PAUSE_LO_MS" > $d/pause_lo
    echo 31             > $d/lut_flags     # loop|ramp_up|reverse|pause_hi|pause_lo
    echo "$duty"        > $d/duty_pcts
    echo 255            > $d/brightness    # just "on"; the LUT sets the level
    echo 1 > $L/green/rgb_start
    echo "pixel2-status-led: $LED pulsing, duty $duty %"
    ;;
stop)
    for c in red green blue; do echo 0 > $L/$c/brightness; done
    echo 1 > $L/green/rgb_start
    ;;
*)  echo "usage: $0 [start|stop]" >&2; exit 2 ;;
esac
