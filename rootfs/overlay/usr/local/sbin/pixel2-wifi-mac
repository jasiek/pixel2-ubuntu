#!/bin/sh
# Same wifi MAC on both kernels, so the router hands out the same IP.
# 4.4 gets the phone's real MAC through Android's cnss-daemon; mainline
# ath10k gets none from the WCN3990 firmware and makes up a random one each
# boot (and the modem answers QMI DMS "get MAC address" with NotProvisioned).
# Both kernels share this rootfs, so 4.4 records the MAC on the phone and
# mainline reuses it. The file never leaves the phone.
#
#   pixel2-wifi-mac record   (4.4) save wlan0's MAC to $SAVED
#   pixel2-wifi-mac hold     (mainline, before NetworkManager) keep NM off wlan0
#   pixel2-wifi-mac          (mainline) wait for wlan0, set the saved MAC, hand wlan0 to NM
SAVED=/var/lib/pixel2/wlan0.mac
HOLD=/run/NetworkManager/conf.d/90-pixel2-wlan0-hold.conf
MACRE='^([0-9a-f]{2}:){5}[0-9a-f]{2}$'

wait_wlan0() {
    for i in $(seq 1 90); do [ -e /sys/class/net/wlan0 ] && return 0; sleep 2; done
    return 1
}

case "${1:-}" in
record)
    wait_wlan0 || exit 0
    mac=$(cat /sys/class/net/wlan0/address)
    echo "$mac" | grep -q -E "$MACRE" || exit 0
    [ "$(cat "$SAVED" 2>/dev/null)" = "$mac" ] && exit 0
    mkdir -p "${SAVED%/*}"
    ( umask 077; echo "$mac" > "$SAVED" )
    echo "pixel2-wifi-mac: recorded wlan0's MAC for mainline"
    exit 0 ;;
hold)
    mkdir -p "${HOLD%/*}"
    printf '[keyfile]\nunmanaged-devices=interface-name:wlan0\n' > "$HOLD"
    exit 0 ;;
esac

release() {
    [ -e "$HOLD" ] || return 0
    rm -f "$HOLD"
    for i in $(seq 1 30); do nmcli general reload conf 2>/dev/null && break; sleep 1; done
    # NM only autoconnects once it has scan results for the new device.
    sleep 2; nmcli device wifi rescan ifname wlan0 2>/dev/null || true
}
trap release EXIT

mac=$(cat "$SAVED" 2>/dev/null)
if ! echo "$mac" | grep -q -E "$MACRE"; then
    # Never booted 4.4 (fresh mainline install): make up one locally
    # administered MAC and keep it, so DHCP gives the same IP every boot.
    # A later 4.4 boot replaces it with the real one (record).
    mac=02; for b in $(od -An -N5 -tx1 /dev/urandom); do mac=$mac:$b; done
    mkdir -p "${SAVED%/*}"
    ( umask 077; echo "$mac" > "$SAVED" )
    echo "pixel2-wifi-mac: no real MAC recorded; generated a stable one"
fi
wait_wlan0 || { echo "pixel2-wifi-mac: no wlan0" >&2; exit 0; }
if [ "$(cat /sys/class/net/wlan0/address)" != "$mac" ]; then
    ip link set wlan0 down
    ip link set wlan0 address "$mac"
fi
ip link set wlan0 up   # a down link leaves wpa_supplicant "interface_disabled"
echo "pixel2-wifi-mac: wlan0 uses the phone's real MAC"
