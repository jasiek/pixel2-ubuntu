#!/usr/bin/perl
# Screen manager for the headless Pixel 2 (OLED: never leave a static image lit).
#   - at start: panel off (pixel2-headless also takes the panel over from the
#     bootloader's continuous splash)
#   - touch (or a volume key): panel on, showing the text console (fbcon/tty1)
#   - IDLE seconds (default 300) without input: panel off again
#
# Input: the Synaptics touchscreen (module synaptics_dsx_core_htc, input name
# "synaptics_dsxv26") still reports touches while the panel is off, and
# gpio-keys (volume keys). Raw evdev reads, no libraries (perl-base only).
use strict;
use warnings;

my $IDLE = $ENV{IDLE} // 300;
my $FB   = '/sys/class/graphics/fb0';
my $OFF  = '/usr/local/sbin/pixel2-headless';
my @NAMES = ('synaptics_dsxv26', 'gpio-keys');

$| = 1;
sub logmsg { print "pixel2-screen: @_\n" }

sub write_sys {
    my ($path, $val) = @_;
    open(my $f, '>', $path) or return 0;
    my $ok = print $f "$val\n";
    close $f or $ok = 0;
    return $ok;
}

sub panel_state {
    open(my $f, '<', "$FB/show_blank_event") or return '?';
    my $s = <$f> // '';
    return $s =~ /(\d+)/ ? $1 : '?';
}

# Map input device names to /dev/input/eventN.
sub find_inputs {
    my %want = map { $_ => 1 } @NAMES;
    my @found;
    open(my $f, '<', '/proc/bus/input/devices') or return;
    local $/ = '';                                # paragraph mode
    while (my $blk = <$f>) {
        my ($name) = $blk =~ /^N: Name="([^"]*)"/m or next;
        my ($ev) = $blk =~ /^H: Handlers=.*\b(event\d+)/m or next;
        push @found, [$name, "/dev/input/$ev"] if $want{$name};
    }
    return @found;
}

my $on = 1;                                       # unknown: force off first
sub screen_off {
    return unless $on;
    system($OFF);                                 # full power-down sequence
    $on = 0;
    logmsg("off (panel_power_on=" . panel_state() . ")");
}
sub screen_on {
    return if $on;
    write_sys("$FB/blank", 0);                    # FB_BLANK_UNBLANK; fbcon redraws
    $on = 1;
    logmsg("on (panel_power_on=" . panel_state() . ")");
}

# The touch module may still be loading at boot.
my @inputs;
for (1 .. 60) {
    @inputs = find_inputs();
    last if grep { $_->[0] eq 'synaptics_dsxv26' } @inputs;
    sleep 1;
}
logmsg("no touchscreen found; volume keys only") unless grep { $_->[0] eq 'synaptics_dsxv26' } @inputs;

my (%fh, $rin);
$rin = '';
for my $in (@inputs) {
    my ($name, $dev) = @$in;
    open(my $h, '<:raw', $dev) or do { logmsg("$dev: $!"); next };
    $fh{fileno $h} = $h;
    vec($rin, fileno $h, 1) = 1;
    logmsg("watching $name ($dev)");
}
die "pixel2-screen: no input devices\n" unless %fh;

# Large console font: 1080x1920 with Terminus 16x32 = 67 columns x 60 rows
# (the kernel's 8x16 default is unreadably small on a 5" screen).
if (-e '/dev/tty1') {
    system('setfont', '-C', '/dev/tty1', $ENV{FONT} // 'Uni2-TerminusBold32x16') == 0
        or logmsg("setfont failed");
}

screen_off();
my $last = time;
while (1) {
    my $timeout = $on ? $IDLE - (time - $last) : undef;
    $timeout = 0 if defined $timeout && $timeout < 0;
    my $n = select(my $rout = $rin, undef, undef, $timeout);
    if ($n > 0) {
        for my $fd (keys %fh) {
            next unless vec($rout, $fd, 1);
            sysread($fh{$fd}, my $buf, 24 * 64);     # drain; any event = activity
        }
        $last = time;
        screen_on();
    } elsif ($on && time - $last >= $IDLE) {
        screen_off();
    }
}
