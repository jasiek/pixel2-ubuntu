# Text console on the screen (tools/pixel2-screen.c): clears the bootloader
# splash at boot, then dark; touch or a volume key shows the console
# (/usr/local/bin/pixel2-console), dark again after IDLE seconds.
[Unit]
Description=Screen: touch to wake the console, off after 5 min idle
After=systemd-modules-load.service

[Service]
Environment=IDLE=300
ExecStart=/usr/local/sbin/pixel2-screen
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
