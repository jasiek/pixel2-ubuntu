# Mainline kernel only (P8.3.6): wlan0 gets the MAC that 4.4 recorded
# (usr/local/sbin/pixel2-wifi-mac). Type=simple: NetworkManager waits only
# for the "hold" step, not for wlan0.
[Unit]
Description=Wifi: use the phone's real MAC (mainline)
ConditionKernelVersion=>=5
Before=NetworkManager.service

[Service]
Type=simple
ExecStartPre=/usr/local/sbin/pixel2-wifi-mac hold
ExecStart=/usr/local/sbin/pixel2-wifi-mac
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
