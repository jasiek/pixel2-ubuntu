From: pixel2 ubuntu port
Subject: [PATCH] drm/panel: add Samsung S6E3FA5 (Pixel 2 walleye)

Command mode 1080x1920 panel; values from the vendor device tree.
---
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -908,6 +908,15 @@
 	  To compile this driver as a module, choose M here: the module
 	  will be called panel-samsung-ltl106hl02.
 
+config DRM_PANEL_SAMSUNG_S6E3FA5
+	tristate "Samsung S6E3FA5 panel driver"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y here if you want to enable support for the Samsung S6E3FA5
+	  1080x1920 command mode panel (Google Pixel 2).
+
 config DRM_PANEL_SAMSUNG_S6E3FA7
 	tristate "Samsung S6E3FA7 panel driver"
 	depends on OF
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -90,6 +90,7 @@
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6D16D0) += panel-samsung-s6d16d0.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6D27A1) += panel-samsung-s6d27a1.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6D7AA0) += panel-samsung-s6d7aa0.o
+obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E3FA5) += panel-samsung-s6e3fa5.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E3FA7) += panel-samsung-s6e3fa7.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E3FC2X01) += panel-samsung-s6e3fc2x01.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E3HA2) += panel-samsung-s6e3ha2.o
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e3fa5.c
@@ -0,0 +1,279 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung S6E3FA5 1080x1920 command mode DSI panel (Google Pixel 2, walleye).
+ *
+ * Init sequence, timings, supplies and reset sequence from the vendor device
+ * tree (android-msm-wahoo-4.4: arch/arm64/boot/dts/htc/dsi-panel-walleye-
+ * s6e3fa5.dtsi and msm8998-htc_muskie.dtsi), written in the style of the
+ * linux-mdss-dsi-panel-driver-generator drivers (e.g. panel-samsung-s6e3fa7).
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+static const struct regulator_bulk_data s6e3fa5_supplies[] = {
+	{ .supply = "vddio" },	/* 1.8 V, vendor "wqhd-vddio" (pm8998 l14) */
+	{ .supply = "vci" },	/* 3.0 V, vendor "vci" (pm8998 l22) */
+};
+
+struct s6e3fa5_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator_bulk_data *supplies;
+	struct gpio_desc *reset_gpio;
+};
+
+static inline struct s6e3fa5_panel *to_s6e3fa5_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct s6e3fa5_panel, panel);
+}
+
+/* Vendor reset sequence <1 1>, <0 1>, <1 10>: line levels, reset is active low */
+static void s6e3fa5_panel_reset(struct s6e3fa5_panel *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+}
+
+static int s6e3fa5_panel_on(struct mipi_dsi_device *dsi)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	mipi_dsi_dcs_set_tear_on_multi(&dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY, 0x20);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xbb, 0x54, 0x00, 0x36, 0x20, 0xf3);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e3fa5_panel_prepare(struct drm_panel *panel)
+{
+	struct s6e3fa5_panel *ctx = to_s6e3fa5_panel(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	/* Vendor: each supply has a 10 ms post-on sleep */
+	ret = regulator_enable(ctx->supplies[0].consumer);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable vddio: %d\n", ret);
+		return ret;
+	}
+	usleep_range(10000, 11000);
+	ret = regulator_enable(ctx->supplies[1].consumer);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable vci: %d\n", ret);
+		regulator_disable(ctx->supplies[0].consumer);
+		return ret;
+	}
+	usleep_range(10000, 11000);
+
+	s6e3fa5_panel_reset(ctx);
+
+	ret = s6e3fa5_panel_on(ctx->dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(s6e3fa5_supplies), ctx->supplies);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int s6e3fa5_panel_disable(struct drm_panel *panel)
+{
+	struct s6e3fa5_panel *ctx = to_s6e3fa5_panel(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 10);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 150);
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e3fa5_panel_unprepare(struct drm_panel *panel)
+{
+	struct s6e3fa5_panel *ctx = to_s6e3fa5_panel(panel);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_disable(ctx->supplies[1].consumer);
+	usleep_range(10000, 11000);	/* vendor: 10 ms pre-off sleep on vddio */
+	regulator_disable(ctx->supplies[0].consumer);
+
+	return 0;
+}
+
+/* Vendor porches: h 18/10/82, v 8/2/16; 60 Hz */
+static const struct drm_display_mode s6e3fa5_panel_mode = {
+	.clock = (1080 + 18 + 10 + 82) * (1920 + 8 + 2 + 16) * 60 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 18,
+	.hsync_end = 1080 + 18 + 10,
+	.htotal = 1080 + 18 + 10 + 82,
+	.vdisplay = 1920,
+	.vsync_start = 1920 + 8,
+	.vsync_end = 1920 + 8 + 2,
+	.vtotal = 1920 + 8 + 2 + 16,
+	.width_mm = 62,
+	.height_mm = 110,
+};
+
+static int s6e3fa5_panel_get_modes(struct drm_panel *panel,
+				   struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &s6e3fa5_panel_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static const struct drm_panel_funcs s6e3fa5_panel_funcs = {
+	.prepare = s6e3fa5_panel_prepare,
+	.unprepare = s6e3fa5_panel_unprepare,
+	.disable = s6e3fa5_panel_disable,
+	.get_modes = s6e3fa5_panel_get_modes,
+};
+
+/* Vendor: bl_ctrl_dcs, levels 1..255 (DCS 0x51, one byte) */
+static int s6e3fa5_panel_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_set_display_brightness(dsi, brightness);
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return ret < 0 ? ret : 0;
+}
+
+static const struct backlight_ops s6e3fa5_panel_bl_ops = {
+	.update_status = s6e3fa5_panel_bl_update_status,
+};
+
+static struct backlight_device *
+s6e3fa5_panel_create_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 96,	/* OLED: start dim (burn-in) */
+		.max_brightness = 255,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &s6e3fa5_panel_bl_ops, &props);
+}
+
+static int s6e3fa5_panel_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct s6e3fa5_panel *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct s6e3fa5_panel, panel,
+				   &s6e3fa5_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(s6e3fa5_supplies),
+					    s6e3fa5_supplies, &ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	/* Command mode (no MIPI_DSI_MODE_VIDEO); init sent in LP (vendor dsi_lp_mode) */
+	dsi->mode_flags = MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM;
+
+	/* Vendor qcom,mdss-dsi-lp11-init: the host must be in LP-11 before reset */
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = s6e3fa5_panel_create_backlight(dsi);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to create backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to attach to DSI host: %d\n", ret);
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void s6e3fa5_panel_remove(struct mipi_dsi_device *dsi)
+{
+	struct s6e3fa5_panel *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id s6e3fa5_panel_of_match[] = {
+	{ .compatible = "samsung,s6e3fa5" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s6e3fa5_panel_of_match);
+
+static struct mipi_dsi_driver s6e3fa5_panel_driver = {
+	.probe = s6e3fa5_panel_probe,
+	.remove = s6e3fa5_panel_remove,
+	.driver = {
+		.name = "panel-samsung-s6e3fa5",
+		.of_match_table = s6e3fa5_panel_of_match,
+	},
+};
+module_mipi_dsi_driver(s6e3fa5_panel_driver);
+
+MODULE_DESCRIPTION("DRM driver for Samsung S6E3FA5 command mode DSI panel (Pixel 2)");
+MODULE_LICENSE("GPL");
