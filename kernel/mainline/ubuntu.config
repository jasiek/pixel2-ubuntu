# Ubuntu additions on top of Porthole's config-postmarketos-qcom-msm8998-7.2 (P8.3).
CONFIG_LOCALVERSION="-walleye-mainline"
# CONFIG_LOCALVERSION_AUTO is not set
# systemd 255
CONFIG_AUTOFS_FS=y
CONFIG_CGROUP_BPF=y
CONFIG_DEVTMPFS=y
CONFIG_FHANDLE=y
# Read crashes back from the next boot (ramoops @0xb0000000 in the wahoo dtsi)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# No debug info: faster build, no pahole needed (Porthole has DEBUG_INFO_BTF)
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DRM_PANEL_SAMSUNG_S6E3FA5=m
CONFIG_RMI4_F11=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
# Camera bring-up (P8.5): Easel power + MIPI bridge as modules, so a hang
# while touching Easel happens after boot, not during it.
CONFIG_REGULATOR_BCM15602_EASEL=m
CONFIG_EASEL_MIPI=m
