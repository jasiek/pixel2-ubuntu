# SPDX-License-Identifier: MIT
# Config fragment merged on top of wahoo_defconfig by scripts/build-kernel.sh.
# Goal: boot a normal systemd-based Ubuntu 24.04 userspace on the stock
# Pixel 2 (walleye) kernel 4.4.223 @ 52750b8f2138.

# --- systemd hard requirements ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS4_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS_POSIX_ACL=y

# --- cgroups (systemd v1/hybrid hierarchy on 4.4) ---
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y

# --- namespaces (systemd sandboxing: PrivateTmp, ProtectSystem, ...) ---
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
CONFIG_BINFMT_MISC=y

# --- Android-only restrictions that break a normal Linux userspace ---
# Without this, only processes in Android's AID_INET group may open sockets.
# CONFIG_ANDROID_PARANOID_NETWORK is not set
# Allow selinux=0 on the cmdline (Ubuntu ships no SELinux policy).
CONFIG_SECURITY_SELINUX_BOOTPARAM=y

# --- USB gadget: networking (NCM is native on macOS) + serial console ---
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y

# --- No text console on the screen ---
# VT + VT_CONSOLE + FRAMEBUFFER_CONSOLE reset the phone early in boot
# (bisect P5.0, 2026-11-17). Headless anyway; revisit in P8.1.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
# P8.1: no fbcon. mdss_fb has no framebuffer memory until userspace mmaps
# fb0, so fbcon would draw through NULL. The VT runs on dummycon and
# userspace (pixel2-screen) draws /dev/vcsa1 into fb0 itself.
# CONFIG_FRAMEBUFFER_CONSOLE is not set
CONFIG_DUMMY_CONSOLE=y
# Text size pixel2-screen draws (1080x1920, 8x16 font at 2x).
CONFIG_DUMMY_CONSOLE_COLUMNS=67
CONFIG_DUMMY_CONSOLE_ROWS=60

# --- Stable release string: /lib/modules/4.4.223-walleye-ubuntu ---
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOCALVERSION="-walleye-ubuntu-vt"

# --- Module symbol CRCs ---
# This 4.4 tree stores CRCs as addresses (&__crc_sym), which KASLR
# relocates, so every module fails with "disagrees about version of symbol
# module_layout". We build all modules ourselves, so CRCs add nothing.
# CONFIG_MODVERSIONS is not set
