[submodule "external/mkbootimg"]
	path = external/mkbootimg
	url = https://android.googlesource.com/platform/system/tools/mkbootimg
[submodule "external/kernel-msm"]
	path = external/kernel-msm
	url = https://android.googlesource.com/kernel/msm
	branch = android-msm-wahoo-4.4-android11
	shallow = true
	ignore = dirty
[submodule "external/qbootctl"]
	path = external/qbootctl
	url = https://github.com/linux-msm/qbootctl
[submodule "external/porthole-pmaports"]
	path = external/porthole-pmaports
	url = https://github.com/porthole-dev/pmaports
	branch = taimen-bringup
	shallow = true
[submodule "external/linux-mainline"]
	shallow = true
	ignore = dirty
	path = external/linux-mainline
	url = https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
